rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function setsOwnerToSelf() { return signedIn() && request.resource.data.ownerUid == request.auth.uid; }

    match /alunos/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();

      match /pacotes/{pkgId} {
        allow read, write: if signedIn() && get(/databases/$(database)/documents/alunos/$(id)).data.ownerUid == request.auth.uid;
      }
    }

    match /aulas/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /evolucoes/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /caixa/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /turmas/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /alunosGrupo/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /matriculas/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /mensalidadesGrupo/{id} {
      allow read: if isOwner();
      allow create: if signedIn() && setsOwnerToSelf();
      allow update, delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}